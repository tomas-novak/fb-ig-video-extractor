# Caddy configuration for FB/IG Video Extractor
#
# Caddy requests the Let's Encrypt certificate on its own and renews it too –
# nothing else around TLS needs configuring. The prerequisite is that the domain
# below points via an A record to this server's IP and that ports 80 and 443 are
# reachable from outside.
#
# Installation:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo nano /etc/caddy/Caddyfile     # fill in the real domain and e-mail
#   sudo systemctl reload caddy
#
# Detailed guide: docs/deploy-vps.md

{
	# E-mail for Let's Encrypt (certificate expiry notifications).
	email you@example.com
}

# FILL IN your domain here, e.g. mybot.duckdns.org
mybot.duckdns.org {
	# The bot listens on localhost only (HOST=127.0.0.1 in .env),
	# so the only route from outside goes through Caddy.
	reverse_proxy 127.0.0.1:8000

	encode gzip

	log {
		output file /var/log/caddy/fbig-bot.log
		# The Telegram webhook fires often – errors are enough.
		level ERROR
	}
}
