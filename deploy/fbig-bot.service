# systemd unit for FB/IG Video Extractor
#
# Installation:
#   sudo cp deploy/fbig-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fbig-bot
#
# Detailed guide: docs/deploy-vps.md

[Unit]
Description=FB/IG Video Extractor (Telegram bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fbigbot
Group=fbigbot
WorkingDirectory=/opt/fbig-bot
# The variables are loaded from /opt/fbig-bot/.env inside the app (load_dotenv in main.py).
# We deliberately do not use EnvironmentFile= – systemd cannot handle the single-line
# JSON in GOOGLE_SERVICE_ACCOUNT_JSON and the service would refuse to start.
ExecStart=/opt/fbig-bot/venv/bin/python main.py

Restart=always
RestartSec=5

# --- Layer 1: memory limits (cgroup) ---
# The bot hits its own ceiling before the whole server runs out of RAM. Any kill
# then happens inside this cgroup and the global OOM killer never fires at all,
# so the other processes on the server stay untouched.
MemoryHigh=500M
MemoryMax=800M
# Without this limit the bot could fill the entire swap and thrash the disk.
MemorySwapMax=512M

# --- Layer 2: fallback for the global OOM ---
# If memory runs out because of another process, the kernel should kill this bot
# first. The range is -1000 to 1000, 1000 = "pick me". Children inherit the value,
# so it also applies to yt-dlp and ffmpeg started during a download.
OOMScoreAdjust=1000
OOMPolicy=continue

# --- Layer 3: CPU and I/O priority ---
# Downloading a video and ffmpeg must not slow down other services (default weight is 100).
Nice=10
CPUWeight=50
IOWeight=50

# --- Security / cleanup ---
# Private /tmp: downloaded videos are isolated and cleaned up automatically on restart.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fbig-bot

[Install]
WantedBy=multi-user.target
