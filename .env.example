TELEGRAM_BOT_TOKEN=123456789:your_bot_token_from_botfather
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SHEETS_ID=your_google_sheet_id_here
# Lokálně: cesta k JSON souboru service accountu
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Na serveru: celý obsah JSON jako jeden řádek
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
WEBHOOK_SECRET=your_random_secret_here
# Google Places API (New) - presne souradnice mist + odkazy na Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
# Claude - posuzovani duplicitnich mist (/zkontroluj)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Carkou oddelena Telegram user ID, ktera smi bota pouzivat (prazdne = kdokoliv)
TELEGRAM_ALLOWED_USERS=
# Token chranici mapu a jeji data - mapa se pak otevira pres /map?token=HODNOTA
# (prazdne = mapa vcetne mazani verejna pro kohokoliv se znalosti URL)
MAP_TOKEN=
# Volitelny read-only token pro sdileni mapy (jen prohlizeni, bez mazani/visited)
MAP_VIEW_TOKEN=
# Verejna adresa instance vcetne https:// - pri startu se automaticky
# zaregistruje Telegram webhook. Napr. https://mujbot.duckdns.org
PUBLIC_URL=
# Adresa, na ktere aplikace posloucha. Za reverse proxy (Caddy/nginx) nastav
# 127.0.0.1, aby port nebyl dostupny primo zvenku. Vychozi: 0.0.0.0 (Docker).
HOST=
# Port aplikace. Vychozi: 8000
PORT=
# Maximalni delka videa v minutach - delsi videa bot odmitne pred stazenim
# (0 = bez limitu). Vychozi: 10
MAX_VIDEO_MINUTES=10
# Jazyk odpovedi bota, mapy a Gemini shrnuti: en (vychozi) nebo cs
BOT_LANGUAGE=
# Vlastni kategorie oddelene carkou (prazdne = vychozi sada podle jazyka).
# Posledni kategorie je zachytna ("jine"/"other") - pouzije se, kdyz AI neurci zadnou.
CATEGORIES=
# Cookies pro Instagram a YouTube (ze serveru je casto vyzaduji).
# Na VPS je nejjednodussi soubor: nahrej cookies.txt vedle aplikace a uved cestu.
COOKIES_FILE=
# Alternativa pro hostingy bez trvaleho disku: cely obsah cookies.txt jako
# hodnota promenne (viceradkovy text musi byt v uvozovkach).
INSTAGRAM_COOKIES=
# Cesta k ffmpeg, kdyz neni v PATH (jinak se najde automaticky).
FFMPEG_LOCATION=
