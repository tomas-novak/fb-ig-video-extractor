TELEGRAM_BOT_TOKEN=123456789:your_bot_token_from_botfather
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SHEETS_ID=your_google_sheet_id_here
# Locally: path to the service account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# On the server: the whole JSON contents as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
WEBHOOK_SECRET=your_random_secret_here
# Google Places API (New) - exact place coordinates + Google Maps links
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
# Claude - judging duplicate places (the dedup command)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Comma-separated Telegram user IDs allowed to use the bot (empty = anyone)
TELEGRAM_ALLOWED_USERS=
# Token protecting the map and its data - the map is then opened via /map?token=VALUE
# (empty = the map, including deletion, is public to anyone who knows the URL)
MAP_TOKEN=
# Optional read-only token for sharing the map (view only, no deleting/visited)
MAP_VIEW_TOKEN=
# Public address of the instance including https:// - the Telegram webhook is
# registered automatically at startup. E.g. https://mybot.duckdns.org
PUBLIC_URL=
# Address the application listens on. Behind a reverse proxy (Caddy/nginx) set
# 127.0.0.1 so the port is not reachable directly from outside. Default: 0.0.0.0 (Docker).
HOST=
# Application port. Default: 8000
PORT=
# Maximum video length in minutes - the bot rejects longer videos before downloading
# (0 = no limit). Default: 10
MAX_VIDEO_MINUTES=10
# Language of the bot's replies, the map and Gemini summaries: en (default) or cs
BOT_LANGUAGE=
# Custom comma-separated categories (empty = the default set for the language).
# The last category is the fallback ("jine"/"other") - used when the AI determines none.
CATEGORIES=
# Cookies for Instagram and YouTube (they often require them when called from a server).
# On a VPS a file is easiest: upload cookies.txt next to the application and set the path.
COOKIES_FILE=
# Alternative for hosting without persistent disk: the whole contents of cookies.txt
# as the variable value (multi-line text must be quoted).
INSTAGRAM_COOKIES=
# Path to ffmpeg when it is not on PATH (otherwise it is found automatically).
FFMPEG_LOCATION=
